# Stripe secret key — Dashboard > Developers > API keys
# Use the sk_test_... key first, switch to sk_live_... only once you've tested a real purchase end to end.
STRIPE_SECRET_KEY=sk_test_...

# Price ID for "The First Collection Blueprint" — Dashboard > Product catalog > (product) > Pricing
# Create the product/price in Stripe first, then paste its price_... ID here.
STRIPE_PRICE_FIRST_COLLECTION_BLUEPRINT=price_...

# Optional. If unset, the app infers the base URL from the incoming request (works fine on Replit).
# Only set this if you put the store behind a custom domain or a proxy that hides the real host.
# BASE_URL=https://your-repl-name.username.repl.co
